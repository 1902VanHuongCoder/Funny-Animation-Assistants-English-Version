          "script": [
            {
              "id": "blk_intro_narration",
              "type": "narration",
              "text": "Welcome to Funny Animation Assistant! Today, Alex and Bob are making their first animated video.",
              "speed": 1,
              "ttsConfig": {
                "duration": 4000,
                "voiceId": 101026
              },
              "actions": [
                {
                  "id": "act_cam_follow_intro",
                  "type": "camera_follow",
                  "category": "duration",
                  "target": "camera",
                  "slotIndex": 0,
                  "slotSpan": 1,
                  "order": 0,
                  "params": {
                    "followTarget": "char_alex_inst_01",
                    "damping": 0,
                    "offsetX": 80,
                    "offsetY": -40,
                    "zoom": 1,
                    "constrainBounds": true
                  }
                }
              ],
              "productionNote": {
                "sourceIndex": 1,
                "scene": "Studio Stage",
                "visual": "Wide camera angle showing Alex and Bob in the studio",
                "audio": "Upbeat studio BGM starts"
              }
            },
            {
              "id": "blk_alex_line_1",
              "type": "dialogue",
              "instanceId": "char_alex_inst_01",
              "text": "Hey Bob! Did you know we can create animations right in the web browser now?",
              "speed": 1,
              "ttsConfig": {
                "duration": 3800,
                "voiceId": 101030
              },
              "actions": [
                {
                  "id": "act_cam_follow_alex",
                  "type": "camera_follow",
                  "category": "duration",
                  "target": "camera",
                  "slotIndex": 0,
                  "slotSpan": 1,
                  "order": 0,
                  "params": {
                    "followTarget": "char_alex_inst_01",
                    "damping": 0,
                    "offsetX": 0,
                    "offsetY": -50,
                    "zoom": 1.1,
                    "constrainBounds": true
                  }
                },
                {
                  "id": "act_alex_nod",
                  "type": "tween_transform",
                  "category": "duration",
                  "target": "char_alex_inst_01",
                  "slotIndex": 0,
                  "slotSpan": 1,
                  "order": 1,
                  "params": {
                    "y": 1410
                  }
                }
              ],
              "productionNote": {
                "sourceIndex": 2,
                "scene": "Studio Stage",
                "visual": "Camera zooms slightly into Alex as he speaks excited",
                "audio": "Alex speaking voice"
              }
            },
            {
              "id": "blk_bob_line_1",
              "type": "dialogue",
              "instanceId": "char_bob_inst_01",
              "text": "Wait, really? Without installing any heavy 3D apps or expensive rendering machines?!",
              "speed": 1,
              "ttsConfig": {
                "duration": 3900,
                "voiceId": 101026
              },
              "actions": [
                {
                  "id": "act_cam_follow_bob",
                  "type": "camera_follow",
                  "category": "duration",
                  "target": "camera",
                  "slotIndex": 0,
                  "slotSpan": 1,
                  "order": 0,
                  "params": {
                    "followTarget": "char_bob_inst_01",
                    "damping": 0,
                    "offsetX": 0,
                    "offsetY": -50,
                    "zoom": 1.15,
                    "constrainBounds": true
                  }
                },
                {
                  "id": "act_bob_shake",
                  "type": "camera_shake",
                  "category": "duration",
                  "target": "camera",
                  "slotIndex": 0,
                  "slotSpan": 1,
                  "order": 1,
                  "params": {
                    "intensity": 6,
                    "frequency": 8
                  }
                }
              ],
              "productionNote": {
                "sourceIndex": 3,
                "scene": "Studio Stage",
                "visual": "Camera shakes with Bob's surprised reaction",
                "audio": "Surprise alert sound"
              }
            },
            {
              "id": "blk_alex_line_2",
              "type": "dialogue",
              "instanceId": "char_alex_inst_01",
              "text": "Exactly! Just type the screenplay, pick voices, and the timeline animates everything automatically!",
              "speed": 1,
              "ttsConfig": {
                "duration": 4200,
                "voiceId": 101030
              },
              "actions": [
                {
                  "id": "act_cam_follow_alex_2",
                  "type": "camera_follow",
                  "category": "duration",
                  "target": "camera",
                  "slotIndex": 0,
                  "slotSpan": 1,
                  "order": 0,
                  "params": {
                    "followTarget": "char_alex_inst_01",
                    "damping": 0,
                    "offsetX": 0,
                    "offsetY": -50,
                    "zoom": 1.05,
                    "constrainBounds": true
                  }
                }
              ],
              "productionNote": {
                "sourceIndex": 4,
                "scene": "Studio Stage",
                "visual": "Alex gestures towards the laptop on the desk",
                "audio": "Alex confident speech"
              }
            },
            {
              "id": "blk_outro_narration",
              "type": "narration",
              "text": "With local-first storage and high-speed WebGL rendering, storytelling is now at your fingertips.",
              "speed": 1,
              "ttsConfig": {
                "duration": 4500,
                "voiceId": 101026
              },
              "actions": [
                {
                  "id": "act_cam_cut_wide",
                  "type": "camera_cut",
                  "category": "point",
                  "target": "camera",
                  "slotIndex": 0,
                  "order": 0,
                  "params": {
                    "x": 3360,
                    "y": 1400,
                    "zoom": 1
                  }
                }
              ],
              "productionNote": {
                "sourceIndex": 5,
                "scene": "Studio Stage",
                "visual": "Camera cuts back to wide shot showing the entire studio and characters",
                "audio": "Music swell and outro fade"
              }
            }
          ]
